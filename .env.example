# SwarmBuild secrets. Copy to .env and fill in your key(s). .env is gitignored.
#
#   cp .env.example .env        # then paste your key(s) below
#
# The key is read SERVER-SIDE ONLY and never reaches the browser (ADR-0005).
# Two consumers:
#   1. Offline bake (bh-03): the deterministic headline is pre-baked, no runtime key.
#        set -a; . ./.env; set +a
#        go run ./cmd/bake -task foundation-1 -type foundation
#   2. Live Build Mode (bh-08): the in-process rovers run the Generator↔Evaluator
#      loop AT RUNTIME when a Blueprint is dropped in "live" mode on the dashboard.
#      `make demo` auto-sources this file, so just set the key and run it:
#        cp .env.example .env    # paste your key
#        make demo               # dashboard at http://localhost:5173
#      (Or restart just the two services that read the key:
#        set -a; . ./.env; set +a
#        docker compose -f deploy/docker-compose.yml up -d coordinator gateway)
#   With NO key, everything still runs as the deterministic REPLAY demo — live just
#   degrades to replay.

# OpenAI (default provider: https://api.openai.com/v1)
OPENAI_API_KEY=

# Gemini OpenAI-compatible endpoint (https://generativelanguage.googleapis.com/v1beta/openai/)
# Set LAB_PROVIDER=gemini to use this instead of OpenAI.
GEMINI_API_KEY=

# Optional provider/model swap (defaults: openai / gpt-4o-2024-08-06).
# LAB_PROVIDER selects the live + bake provider: openai | gemini | local (Ollama).
LAB_PROVIDER=
LAB_MODEL=
