# SwarmBuild Build-harness secrets (bh-03). Copy to .env and fill in.
# .env is gitignored and is loaded ONLY for the offline `go run ./cmd/bake` step;
# no key ever reaches the runtime services or the browser (ADR-0005, TECHSPEC §8).
#
#   cp .env.example .env   # then paste your key(s)
#   set -a; . ./.env; set +a
#   go run ./cmd/bake -task foundation-1 -type foundation

# OpenAI (default provider: https://api.openai.com/v1)
OPENAI_API_KEY=

# Gemini OpenAI-compatible endpoint (https://generativelanguage.googleapis.com/v1beta/openai/)
# go run ./cmd/bake -provider gemini -model gemini-2.0-flash
GEMINI_API_KEY=