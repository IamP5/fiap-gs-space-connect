# SwarmBuild web dashboard configuration.
# Copy to `.env` (or `.env.local`) and adjust as needed.

# WebSocket URL of the WS gateway. The gateway fans out the ~10 Hz world
# snapshot the dashboard renders. Defaults to ws://localhost:8080/ws.
VITE_WS_URL=ws://localhost:8080/ws

# Set to 1 to run against a hardcoded in-browser mock snapshot instead of a
# live gateway (useful to see the UI with no backend). Leave unset/0 normally.
# VITE_MOCK=1
